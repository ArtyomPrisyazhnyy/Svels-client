# Необязательно: если не задан, в браузере API = тот же хост, что и frontend (удобно для 192.168.x.x)
# NEXT_PUBLIC_API_URL=http://192.168.0.238:3000
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
NEXT_PUBLIC_SITE_URL=http://localhost:3001

# Демо-заведение на лендинге (фиктивная «Чайка», mock API id: demo)
NEXT_PUBLIC_DEMO_RESTAURANT_URL=/restaurants/demo

# On-demand ISR: секрет для POST /api/revalidate (тот же в Svels-backend/.env)
REVALIDATE_SECRET=dev-revalidate-secret

# Хосты платформы (через запятую). Все остальные Host → custom domain ресторана.
NEXT_PUBLIC_PLATFORM_HOSTS=localhost,127.0.0.1,svels.by,www.svels.by

# URL API для SSR/middleware (на проде — внутренний адрес backend)
# NEXT_PUBLIC_API_URL=http://127.0.0.1:3000

# Яндекс.Карты JS API. Без ключа карта всё равно грузится, ключ — для прода.
# https://developer.tech.yandex.ru/
# NEXT_PUBLIC_YANDEX_MAPS_KEY=

# --- Docker (см. docs/deploy.md) ---
# NEXT_PUBLIC_* задаются при docker build --build-arg; REVALIDATE_SECRET — при docker run / в compose web.
# Пример: docker build --build-arg NEXT_PUBLIC_API_URL=https://api.svels.by -t svels-client:latest .
