    "next": "^15.5.4",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-konva": "^19.2.5",
    "react-rnd": "^10.5.3",
    "use-image": "^1.1.4",
    "uuid": "^14.0.1",
    "zustand": "^5.0.14"
