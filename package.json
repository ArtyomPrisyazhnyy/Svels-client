{
  "name": "svels-client",
  "private": true,
  "version": "0.0.0",
  "scripts": {
    "dev": "next dev --turbopack -p 3001",
    "dev:webpack": "next dev -p 3001",
    "dev:clean": "rm -rf .next && next dev --turbopack -p 3001",
    "ports:free": "bash ../scripts/free-ports.sh 3001",
    "clean": "rm -rf .next",
    "build": "next build",
    "start": "next start -p 3001",
    "lint": "eslint .",
    "test:unit": "node --experimental-strip-types --test src/features/restaurants/utils/cart-items-label.util.test.ts src/features/restaurants/utils/loyalty-flame-info.util.test.ts src/features/restaurants/utils/flame-theme-vars.test.ts src/features/restaurants/utils/flame-paint.test.ts src/shared/utils/phone-input-edit.util.test.ts src/shared/images/menu-image.test.ts",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:report": "playwright show-report e2e/playwright-report",
    "capture:loyalty-flame": "playwright test --config=playwright.capture.config.ts",
    "check:ui-tokens": "node scripts/check-ui-tokens.mjs"
  },
  "dependencies": {
    "@microsoft/fetch-event-source": "^2.0.1",
    "@react-oauth/google": "^0.13.5",
    "@sentry/nextjs": "^9.47.2",
    "embla-carousel-autoplay": "^8.6.0",
    "embla-carousel-react": "^8.6.0",
    "konva": "^10.3.0",
    "next": "^15.5.4",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-konva": "^19.2.5",
    "react-rnd": "^10.5.3",
    "use-image": "^1.1.4",
    "uuid": "^14.0.1",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@eslint/js": "^9.39.1",
    "@playwright/test": "^1.62.0",
    "@types/node": "^24.12.3",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "dotenv": "^17.4.2",
    "eslint": "^9.39.1",
    "eslint-config-next": "^15.5.4",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.6.0",
    "sass": "^1.101.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.59.2"
  }
