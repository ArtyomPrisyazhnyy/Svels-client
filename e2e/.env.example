# Базовые URL (по умолчанию localhost)
E2E_BASE_URL=http://127.0.0.1:3001
E2E_API_URL=http://127.0.0.1:3000

# В Svels-backend/.env для e2e (не дублируются здесь):
# NODE_ENV=development
# ENABLE_DEV_ENDPOINTS=true
# CORS_ALLOWED_ORIGINS=http://localhost:3001,http://127.0.0.1:3001

# Суперадмин для global-setup (можно не дублировать — подтянется из Svels-backend/.env)
# E2E_SUPER_ADMIN_EMAIL=admin@example.com
# E2E_SUPER_ADMIN_PASSWORD=your-password

# Fallback для seed restaurant_production, если на backend ещё нет POST /restaurants/:id/staff
# E2E_DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/svels

# Если frontend/backend уже запущены вручную:
# E2E_SKIP_WEBSERVER=1
